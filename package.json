{
  "name": "dsh-session-cards",
  "version": "0.4.2",
  "type": "module",
  "description": "Session cards for DeepSeek Harness: draggable conversation cards on a board inside the session canvas, plus native floating windows.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "popout",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "cards",
    "board",
    "workspace",
    "popout"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2"
  },
  "scripts": {
    "test": "node --test test/",
    "build:client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "tom143tc",
  "homepage": "https://github.com/tom143tc/dsh-session-card#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom143tc/dsh-session-card.git"
  },
  "bugs": {
    "url": "https://github.com/tom143tc/dsh-session-card/issues"
  }
}
